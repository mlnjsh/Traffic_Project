# === Database ===
DATABASE_URL=postgresql+asyncpg://user:pass@host.neon.tech/traffic_db?sslmode=require

# === Redis ===
UPSTASH_REDIS_URL=https://xxxx.upstash.io
UPSTASH_REDIS_TOKEN=xxxx

# === TomTom ===
TOMTOM_API_KEY=your_tomtom_api_key_here

# === ASTraM/BTP ===
ASTRAM_API_URL=https://astram.btp.gov.in/api/v1
ASTRAM_API_KEY=your_astram_api_key_here

# === Google Maps ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# === Application ===
ENVIRONMENT=development
LOG_LEVEL=info
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000
BANGALORE_BBOX=12.85,77.45,13.15,77.80
POLL_INTERVAL_SECONDS=120
